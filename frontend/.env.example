# ─── API Base URL ────────────────────────────────────────────────────────────
# Must match your Django backend URL — change port if backend runs elsewhere
# Use full backend URL, or `/api/v1` with Vite proxy (see vite.config.js)
VITE_API_BASE_URL=/api/v1

# ─── App Info ────────────────────────────────────────────────────────────────
VITE_APP_NAME=Inventory Management System
VITE_APP_VERSION=1.0.0

# ─── Auth Token Keys (localStorage) ─────────────────────────────────────────
# These are the keys used to store JWT tokens in localStorage
VITE_ACCESS_TOKEN_KEY=ims_access_token
VITE_REFRESH_TOKEN_KEY=ims_refresh_token

# ─── Pagination ──────────────────────────────────────────────────────────────
VITE_DEFAULT_PAGE_SIZE=25

# ─── Currency & Locale ───────────────────────────────────────────────────────
VITE_CURRENCY_SYMBOL=Rs.
VITE_LOCALE=en-PK

# ─── Feature Flags (set to 'true' or 'false') ────────────────────────────────
VITE_ENABLE_CAMERA_SCANNER=true
VITE_ENABLE_LOYALTY_POINTS=true
