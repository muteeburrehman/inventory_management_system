# ─── API Base URL ────────────────────────────────────────────────────────────
# Default recommendation: talk to Django directly (fewer “Network Error” issues than the dev proxy).
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
#
# Alternative: same-origin + Vite proxy (vite.config.js forwards /api → Django).
# VITE_API_BASE_URL=/api/v1

# When VITE_API_BASE_URL=/api/v1, Vite proxies /api → this Django base URL (override if runserver uses another port).
# VITE_PROXY_TARGET=http://127.0.0.1:8000

# ─── App Info ────────────────────────────────────────────────────────────────
VITE_APP_NAME=Inventory Management System
VITE_APP_VERSION=1.0.0

# ─── Auth Token Keys (localStorage) ─────────────────────────────────────────
# These are the keys used to store JWT tokens in localStorage
VITE_ACCESS_TOKEN_KEY=ims_access_token
VITE_REFRESH_TOKEN_KEY=ims_refresh_token

# ─── Pagination ──────────────────────────────────────────────────────────────
VITE_DEFAULT_PAGE_SIZE=25

# ─── Currency & Locale ───────────────────────────────────────────────────────
VITE_CURRENCY_SYMBOL=Rs.
VITE_LOCALE=en-PK

# ─── Feature Flags (set to 'true' or 'false') ────────────────────────────────
VITE_ENABLE_CAMERA_SCANNER=true
VITE_ENABLE_LOYALTY_POINTS=true
