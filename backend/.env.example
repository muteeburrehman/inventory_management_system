# ─── Django Core ────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-very-long-random-secret-key-change-this-before-use

DEBUG=True

# Comma-separated list of allowed hosts for development
ALLOWED_HOSTS=localhost,127.0.0.1

# true = use backend/db.sqlite3 (no PostgreSQL needed). false = use DB_* below.
USE_SQLITE=true

# ─── Database — PostgreSQL ───────────────────────────────────────────────────
# Make sure PostgreSQL is installed and this database exists before running migrations
DB_NAME=inventory_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# ─── CORS — Frontend Origin ──────────────────────────────────────────────────
# Must match the URL where your React dev server runs
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── JWT Token Lifetimes ─────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# ─── Media & Static Files ────────────────────────────────────────────────────
# In development these are served by Django runserver automatically
MEDIA_URL=/media/
MEDIA_ROOT=media/
STATIC_URL=/static/
STATIC_ROOT=staticfiles/

# ─── Email (optional — for system notifications) ─────────────────────────────
# Using console backend means emails print to terminal — safe for development
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
# Use a Gmail App Password (not your real password): myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL="Inventory System <your_email@gmail.com>"

# ─── Business Defaults ───────────────────────────────────────────────────────
DEFAULT_CURRENCY=PKR
DEFAULT_TAX_PERCENT=0.00

# Stock level at which a low-stock notification is triggered (fallback if not set per product)
LOW_STOCK_THRESHOLD=10

# Use development settings locally
DJANGO_SETTINGS_MODULE=config.settings.development

# Production / Docker: see repo root docker-compose.yml and deploy/.env.example (compose sets
# DJANGO_SETTINGS_MODULE=config.settings.production in the backend container).
