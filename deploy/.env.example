# Copy this file to the repository root as `.env` (next to `docker-compose.yml`).
# Do not commit `.env`.

# ─── Public hosts (DNS A/AAAA → your VPS IP) ────────────────────────────────
# Recommended for https://qubixsolution.com portfolio company:
#   Frontend (React):  inventory.qubixsolution.com
#   Backend (Django): inventory-api.qubixsolution.com
#
# Alternatives if you prefer shorter names:
#   ims.qubixsolution.com  +  ims-api.qubixsolution.com
#   stock.qubixsolution.com + stock-api.qubixsolution.com

FRONTEND_HOST=inventory.qubixsolution.com
API_HOST=inventory-api.qubixsolution.com

# Email for Let's Encrypt (certificate expiry notices)
LETSENCRYPT_EMAIL=support@qubixsolution.com

# ─── Django ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-generate-with-django-get-random-secret-key
# ALLOWED_HOSTS is set from API_HOST in docker-compose (single host).
# Add more in compose if needed: host1.com,host2.com

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_NAME=ims
DB_USER=ims
DB_PASSWORD=use-a-long-random-password

# CORS is set in docker-compose from FRONTEND_HOST (https://your-frontend-host)
# Add www only if you serve the SPA on www and need browser calls to the API:
# CORS_ALLOWED_ORIGINS=https://inventory.qubixsolution.com,https://www.inventory.qubixsolution.com
# (Then extend docker-compose backend.environment for CORS_ALLOWED_ORIGINS.)

# CSRF defaults are built from API_HOST + FRONTEND_HOST in docker-compose.yml
